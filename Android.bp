package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Deliberately not privileged: this app parses data from the network, so it only gets INTERNET and,
// if the user chooses device location, coarse location. Its provider is only readable by the system.
android_app {
    name: "GraphiteWeather",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    system_ext_specific: true,
    platform_apis: true,
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibSettingsTheme",
    ],
    optimize: {
        enabled: false,
    },
}
